# Local development overrides — copy to docker-compose.override.yml
# (git-ignored) to mount source for hot reload instead of rebuilding images.

services:
  api:
    build:
      target: builder
    command: >
      sh -c "uvicorn quantix_api.main:app --host 0.0.0.0 --port 8000 --reload"
    volumes:
      - ./apps/api/src:/app/src
    environment:
      DEBUG: "true"

  web:
    command: npm run dev
    volumes:
      - ./apps/web/src:/app/src
      - ./apps/web/public:/app/public
    environment:
      NODE_ENV: development
