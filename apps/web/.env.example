# Quantix Web — environment configuration template.
# Copy to .env.local for local development: cp .env.example .env.local

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# There's no login/signup UI — every visitor is silently authenticated
# into one shared demo workspace via POST /auth/demo-login on first load
# (see src/app/(app)/layout.tsx and docs/adr/0008-demo-session-bootstrap.md).
# That identity is fixed server-side (apps/api's demo_login.py), so there's
# nothing to configure here.
