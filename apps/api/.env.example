# Quantix API — environment configuration template.
# Copy to .env for local development: cp .env.example .env

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- API ---
API_V1_PREFIX=/api/v1
PROJECT_NAME="Quantix AI"
ALLOWED_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000
# Publicly reachable base URL of THIS API — used to build OAuth redirect_uris.
# Must match what's registered in each provider's OAuth app console.
API_PUBLIC_URL=http://localhost:8000

# --- Security ---
SECRET_KEY=change-me-to-a-64-char-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
ALGORITHM=HS256
# Encrypts data-source credentials at rest — separate from SECRET_KEY so
# the two can rotate independently. Defaults to a dev-only placeholder if
# left unset; set a real random value in production.
CREDENTIAL_ENCRYPTION_KEY=dev-only-credential-key-change-in-production

# --- Anthropic (chat agents — see ADR-0004) ---
# Required for the chat/agent system to work at all. Get one at
# console.anthropic.com.
ANTHROPIC_API_KEY=

# --- PostgreSQL (primary datastore) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=quantix
POSTGRES_PASSWORD=quantix_dev_password
POSTGRES_DB=quantix
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Redis (cache + Celery broker) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Qdrant (vector search) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- OAuth providers ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
