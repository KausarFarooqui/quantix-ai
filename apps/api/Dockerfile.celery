# syntax=docker/dockerfile:1.7
# Celery worker — reuses the API's dependency set (agents run as tasks).

FROM python:3.13-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /uvx /bin/
WORKDIR /build
# Same two-pass pattern as apps/api/Dockerfile (see its comments for the
# full explanation): pass one is editable and runs before `src` exists,
# just to cache dependency resolution; pass two — after COPY src — does a
# real, non-editable install. This image's runtime stage only copies
# /opt/venv, not /build, so an editable install here would leave
# `quantix_api` unimportable at runtime, which matters even more for this
# image than the API's — the CMD below imports it directly to find the
# Celery app. Also copies README.md, which hatchling's build requires
# (pyproject.toml declares `readme = "README.md"`) and which wasn't being
# copied at all before.
COPY pyproject.toml README.md ./
RUN uv venv /opt/venv --python 3.13 && \
    . /opt/venv/bin/activate && uv pip install --no-cache -e .
COPY src ./src
RUN . /opt/venv/bin/activate && uv pip install --no-cache --no-deps .

FROM python:3.13-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends libpq5 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 quantix

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" PYTHONUNBUFFERED=1

WORKDIR /app
COPY --chown=quantix:quantix src ./src

# Same fix as apps/api/Dockerfile: the celery worker shares the API's
# LocalFileStorage (dataset sync tasks read/write ./data/...), and /app is
# root-owned by default — without pre-creating and chowning this, any task
# that touches file storage would PermissionError the same way the API's
# register endpoint did.
RUN mkdir -p /app/data/uploads /app/data/datasets && \
    chown -R quantix:quantix /app/data

USER quantix

CMD ["celery", "-A", "quantix_api.infrastructure.celery.app", "worker", "--loglevel=info", "--concurrency=4"]
